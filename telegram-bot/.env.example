# ─── Telegram ────────────────────────────────────────────────────
# Secret name: TOKEN  (exactly as set in Railway/Replit)
TOKEN=your_telegram_bot_token_here

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── AI Provider Selection ────────────────────────────────────────
# Options: groq | openai | openrouter | anthropic | openai_like | google
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# ─── AI API Keys (use the key that matches AI_PROVIDER) ──────────
GROQ_API_KEY=your_groq_key
OPENAI_API_KEY=your_openai_key
OPEN_ROUTER_API_KEY=your_openrouter_key
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_LIKE_API_KEY=your_custom_endpoint_key
OPENAI_LIKE_BASE_URL=https://api.together.xyz/v1
GOOGLE_GENERATIVE_AI_API_KEY=your_google_key

# ─── Admin ───────────────────────────────────────────────────────
OWNER_ID=your_telegram_numeric_user_id

# ─── Bot Channel Links ────────────────────────────────────────────
SUPPORT_CHANNEL=https://t.me/your_support_channel
UPDATES_CHANNEL=https://t.me/your_updates_channel
GIFT_CHANNEL=https://t.me/your_gift_channel

# ─── Developer Social Links ──────────────────────────────────────
DEV_INSTAGRAM=https://instagram.com/yourprofile
DEV_TELEGRAM=https://t.me/yourprofile
DEV_TIKTOK=https://tiktok.com/@yourprofile
DEV_FACEBOOK=https://facebook.com/yourprofile
DEV_WHATSAPP=https://wa.me/yournumber
DEV_SUPPORT=https://t.me/yoursupportuser

# ─── GitHub / Railway (for CI, not used by bot code) ─────────────
GITHUB_TOKEN=your_github_token
RAILWAY_TOKEN=your_railway_token
