# ─── Telegram ────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── AI Providers (fill at least one) ────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ─── Active AI Provider: groq | openai | openrouter | google ─────
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# ─── Bot Links ───────────────────────────────────────────────────
SUPPORT_CHANNEL=https://t.me/your_support_channel
UPDATES_CHANNEL=https://t.me/your_updates_channel
GIFT_CHANNEL=https://t.me/your_gift_channel

# ─── Developer Social Links ──────────────────────────────────────
DEV_INSTAGRAM=https://instagram.com/yourprofile
DEV_TELEGRAM=https://t.me/yourprofile
DEV_TIKTOK=https://tiktok.com/@yourprofile
DEV_FACEBOOK=https://facebook.com/yourprofile
DEV_WHATSAPP=https://wa.me/yournumber
DEV_SUPPORT=https://t.me/yoursupportuser
